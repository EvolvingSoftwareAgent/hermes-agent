+def test_refresh_nous_oauth_from_state_serializes_under_shared_lock(tmp_path, monkeypatch):
+    """Regression for the concurrent-refresh race that quarantined Nous auth.
+
+    Nous refresh tokens are single-use and rotate on every refresh. When two
+    Hermes processes refresh concurrently (gateway runtime path, credential
+    pool, web-server device-code poll, CLI), both can POST the same refresh
+    token; the loser hits ``invalid_grant`` / ``refresh_token_reused`` and the
+    whole session chain is quarantined (#15099). ``refresh_nous_oauth_from_state``
+    must serialize the POST through the cross-process shared-store lock and,
+    after acquiring it, re-merge the shared store so a concurrent winner's
+    rotated token is adopted instead of POSTing the stale one.
+    """
+    from hermes_cli import auth as auth_mod
+
+    # Simulate a concurrent winner: before the pure refresh runs, the shared
+    # store already holds a rotated token pair.
+    rotated = {
+        "access_token": "access-rotated",
+        "refresh_token": "refresh-rotated",
+        "expires_at": _future_iso(3600),
+    }
+    monkeypatch.setattr(auth_mod, "_read_shared_nous_state", lambda: dict(rotated))
+
+    posts = []
+
+    def _fake_refresh(access_token, refresh_token, client_id, portal_base_url,
+                      inference_base_url, **kwargs):
+        posts.append(refresh_token)
+        return {
+            "access_token": "access-fresh",
+            "refresh_token": "refresh-fresh",
+            "expires_in": 3600,
+            "inference_base_url": inference_base_url,
+        }
+
+    monkeypatch.setattr(auth_mod, "refresh_nous_oauth_pure", _fake_refresh)
+
+    # Shared-state path must resolve for the lock's lock_path lookup.
+    monkeypatch.setattr(auth_mod, "_nous_shared_store_path", lambda: tmp_path / "shared.json")
+
+    state = dict(_full_state_fixture())
+    state["refresh_token"] = "refresh-stale"
+    result = auth_mod.refresh_nous_oauth_from_state(state)
+
+    # The stale token must never be POSTed: the rotated one is adopted instead.
+    assert posts == ["refresh-rotated"]
+    assert result is not None
+
+
